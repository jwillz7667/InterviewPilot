#!/usr/bin/env bash
# Opt-in staged secret scan. Compatible with the Bash shipped on macOS.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "warning: gitleaks is not installed; staged secrets were not checked." >&2
  exit 0
fi

if ! gitleaks protect --staged --redact --no-banner; then
  echo "Remove the reported secret from staged changes before committing." >&2
  echo "Rotate any credential that has already been committed." >&2
  exit 1
fi
