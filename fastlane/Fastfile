# InterviewPilot — Fastlane lanes
#
# Lanes:
#   beta         — build + upload to TestFlight (internal testers + external if configured)
#   release      — build + submit to App Store Connect for review
#   screenshots  — drive snapshot tests to capture screenshots for App Store
#   tests        — run xcodebuild test suite (placeholder until Phase C2 ships XCTest target)
#
# Required env (CI):
#   APP_STORE_CONNECT_API_KEY_ID
#   APP_STORE_CONNECT_API_ISSUER_ID
#   APP_STORE_CONNECT_API_KEY_CONTENT  (base64-encoded .p8 contents)
#   MATCH_PASSWORD                      (for cert/profile decryption — once match is set up)
#   MATCH_GIT_URL                       (private repo holding encrypted certs)
#
# See `docs/runbooks/testflight.md` for first-time setup.

default_platform(:ios)

XCODE_PROJECT = 'InterviewPilot.xcodeproj'
SCHEME = 'InterviewPilot'
BUNDLE_ID = 'com.res.jobhopperAI'

def app_store_connect_api_key_or_nil
  return nil unless ENV['APP_STORE_CONNECT_API_KEY_ID']
  app_store_connect_api_key(
    key_id: ENV['APP_STORE_CONNECT_API_KEY_ID'],
    issuer_id: ENV['APP_STORE_CONNECT_API_ISSUER_ID'],
    key_content: ENV['APP_STORE_CONNECT_API_KEY_CONTENT'],
    is_key_content_base64: true,
    in_house: false
  )
end

platform :ios do
  before_all do
    setup_ci if ENV['CI']
  end

  desc 'Build + upload to TestFlight'
  lane :beta do
    api_key = app_store_connect_api_key_or_nil

    # Match pulls the signing cert + provisioning profile from the encrypted
    # match repo. Until the user provisions match, this lane requires a local
    # signing identity already configured in Xcode.
    if ENV['MATCH_GIT_URL']
      match(
        type: 'appstore',
        app_identifier: BUNDLE_ID,
        readonly: ENV['CI'] == 'true',
        api_key: api_key
      )
    end

    increment_build_number(xcodeproj: XCODE_PROJECT)

    build_app(
      project: XCODE_PROJECT,
      scheme: SCHEME,
      configuration: 'Release',
      export_method: 'app-store',
      output_directory: 'build/fastlane',
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: ENV['TESTFLIGHT_CHANGELOG'] || default_changelog
    )

    commit_version_bump(
      message: 'chore(ios): bump build number [skip ci]',
      xcodeproj: XCODE_PROJECT,
      force: true
    ) unless ENV['CI'].nil?
  end

  desc 'Submit a release to App Store Connect'
  lane :release do
    api_key = app_store_connect_api_key_or_nil

    if ENV['MATCH_GIT_URL']
      match(type: 'appstore', app_identifier: BUNDLE_ID, readonly: true, api_key: api_key)
    end

    build_app(
      project: XCODE_PROJECT,
      scheme: SCHEME,
      configuration: 'Release',
      export_method: 'app-store',
      output_directory: 'build/fastlane',
      clean: true
    )

    upload_to_app_store(
      api_key: api_key,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      skip_metadata: false,
      precheck_include_in_app_purchases: true
    )
  end

  desc 'Capture App Store screenshots via UI tests'
  lane :screenshots do
    capture_screenshots(
      project: XCODE_PROJECT,
      scheme: 'InterviewPilotUITests',
      devices: [
        'iPhone 15 Pro Max',
        'iPhone 15',
        'iPhone 8 Plus'
      ]
    )
  end

  desc 'Run the iOS unit test suite (requires Phase C2 XCTest target)'
  lane :tests do
    run_tests(
      project: XCODE_PROJECT,
      scheme: SCHEME,
      devices: ['iPhone 15']
    )
  end

  def default_changelog
    sha = (sh('git rev-parse --short HEAD', log: false) || '').strip
    "Internal build #{sha}"
  end

  error do |lane, exception|
    slack(
      message: "🚨 fastlane #{lane} failed: #{exception.message}",
      success: false,
      slack_url: ENV['SLACK_OPS_WEBHOOK']
    ) if ENV['SLACK_OPS_WEBHOOK']
  end
end
