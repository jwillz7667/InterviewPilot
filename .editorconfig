# EditorConfig — https://editorconfig.org
# Top-most config; do not inherit from parent directories.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.swift]
indent_size = 4

[*.{py,sh,bash}]
indent_size = 4

[Makefile]
indent_style = tab

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

[*.{prisma}]
indent_size = 2
