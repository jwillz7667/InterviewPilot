generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  TRIAL
  PLUS
  PRO
  PREMIUM
  SANDBOX
}

enum SubscriptionStatus {
  FREE
  TRIALING
  ACTIVE
  IN_GRACE_PERIOD
  EXPIRED
  CANCELED
  REVOKED
  SANDBOX
}

enum BillingProvider {
  INTERNAL
  APP_STORE
}

enum SubscriptionProduct {
  NONE
  PLUS_MONTHLY
  PLUS_YEARLY
  PRO_MONTHLY
  PRO_YEARLY
  PREMIUM_MONTHLY
  PREMIUM_YEARLY
  SANDBOX_FULL_ACCESS
}

enum InterviewQuality {
  STANDARD
  PREMIUM
}

enum AppStoreEnvironment {
  SANDBOX
  PRODUCTION
}

enum UserRole {
  USER
  ADMIN
}

enum AccessSource {
  TRIAL
  SUBSCRIPTION
  SANDBOX
}

enum SessionMode {
  LIVE_INTERVIEW
  VOICE_PREP
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  displayName   String?
  avatarUrl     String?
  appAccountToken String? @unique @default(uuid())

  appleId       String?   @unique
  googleId      String?   @unique
  isSandboxTester Boolean @default(false)

  linkedinUrl          String?
  primaryGoal          String?
  resumeFileUrl        String?
  resumeText           String?   @db.Text
  currentRole          String?
  currentCompany       String?
  yearsInRole          Int?
  onboardingCompleted  Boolean  @default(false)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  emailVerified Boolean   @default(false)
  deletedAt     DateTime?
  role          UserRole  @default(USER)

  sessions      InterviewSession[]
  settings      UserSettings?
  apiKeys       UserApiKey[]
  answerBanks   AnswerBank[]
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  entitlement   UserEntitlement?
  billingEvents BillingEvent[]
  sessionAccessGrants SessionAccessGrant[]
  workExperiences    WorkExperience[]
  skills             UserSkill[]
  interviewProfiles  InterviewProfile[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model UserEntitlement {
  id                           String              @id @default(cuid())
  userId                       String              @unique
  user                         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                         SubscriptionTier    @default(TRIAL)
  status                       SubscriptionStatus  @default(TRIALING)
  provider                     BillingProvider     @default(INTERNAL)
  product                      SubscriptionProduct @default(NONE)
  productId                    String?
  featuresOverride             Json?
  trialInterviewLimit          Int                 @default(5)
  trialInterviewsUsed          Int                 @default(0)
  trialStartedAt               DateTime?
  trialEndsAt                  DateTime?
  monthlyInterviewsUsed        Int                 @default(0)
  monthlyInterviewsResetAt     DateTime?
  monthlyStandardUsed          Int                 @default(0)
  monthlyPremiumUsed           Int                 @default(0)
  monthlyStandardLimit         Int                 @default(3)
  monthlyPremiumLimit          Int                 @default(1)
  quotaPeriodStartedAt         DateTime            @default(now())
  quotaPeriodEndsAt            DateTime?
  currentPeriodStartedAt       DateTime            @default(now())
  currentPeriodEndsAt          DateTime?
  gracePeriodEndsAt            DateTime?
  lastPurchasedAt              DateTime?
  lastVerifiedAt               DateTime?
  appStoreEnvironment          AppStoreEnvironment?
  appStoreOriginalTransactionId String?            @unique
  appStoreLatestTransactionId  String?             @unique
  sandboxFullAccess            Boolean             @default(false)
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  billingEvents                BillingEvent[]

  @@index([status, tier])
  @@index([currentPeriodEndsAt])
  @@map("user_entitlements")
}

model BillingEvent {
  id                           String              @id @default(cuid())
  userId                       String
  user                         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  entitlementId                String?
  entitlement                  UserEntitlement?    @relation(fields: [entitlementId], references: [id], onDelete: SetNull)
  provider                     BillingProvider
  eventType                    String
  product                      SubscriptionProduct?
  productId                    String?
  appStoreTransactionId        String?
  appStoreOriginalTransactionId String?
  appStoreEnvironment          AppStoreEnvironment?
  effectiveAt                  DateTime?
  expiresAt                    DateTime?
  payload                      Json?
  payloadDigest                String?
  quotaDelta                   Json?
  createdAt                    DateTime            @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([appStoreTransactionId])
  @@index([appStoreOriginalTransactionId])
  @@map("billing_events")
}

model SessionAccessGrant {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionClientId    String           @unique
  sessionMode        SessionMode      @default(LIVE_INTERVIEW)
  accessSource       AccessSource
  accessTier         SubscriptionTier
  quality            InterviewQuality @default(STANDARD)
  featureSnapshot    Json?
  consumedTrial      Boolean          @default(false)
  trialInterviewNumber Int?
  createdAt          DateTime         @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("session_access_grants")
}

model UserSettings {
  id                     String  @id @default(cuid())
  userId                 String  @unique
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  defaultInterviewType   String  @default("general")
  defaultResponseFormat  String  @default("hybrid")
  defaultModel           String  @default("gpt-4.1-nano")
  shouldPreGenerate      Boolean @default(true)

  responseTemperature    Float   @default(0.7)
  maxResponseTokens      Int     @default(800)
  maxPreComputedQs       Int     @default(25)

  utteranceEndMs         Int     @default(1500)
  endpointingMs          Int     @default(500)
  predictiveFireMinWords Int     @default(8)

  responseTone        String  @default("natural")
  responseEmphasis    String  @default("balanced")
  responseBehavior    String  @default("direct")

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("user_settings")
}

model UserApiKey {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider     String   // "deepgram" | "openai"
  encryptedKey String
  keyIv        String
  keyTag       String
  keyPrefix    String   // First 4 chars for display

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@map("user_api_keys")
}

model InterviewSession {
  id              String     @id @default(cuid())
  clientId        String     @unique
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionMode     SessionMode @default(LIVE_INTERVIEW)
  accessSource    AccessSource @default(TRIAL)
  accessTier      SubscriptionTier @default(TRIAL)
  quality         InterviewQuality @default(STANDARD)
  trialInterviewNumber Int?

  startedAt       DateTime
  endedAt         DateTime?
  resumeText      String
  jobDescription  String
  jobListingUrl   String?
  profileId       String?
  interviewType   String
  responseFormat  String
  modelUsed       String
  totalTokensUsed Int        @default(0)
  estimatedCost   Float      @default(0)
  telemetrySummary Json?

  technicalAccuracyScore  Float?
  communicationScore      Float?
  confidenceScore         Float?
  aiStrengths             Json?
  aiImprovements          Json?
  overallScore            Int?

  exchanges       Exchange[]

  deletedAt       DateTime?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId, startedAt(sort: Desc)])
  @@map("interview_sessions")
}

model Exchange {
  id                 String           @id @default(cuid())
  clientId           String           @unique
  sessionId          String
  session            InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  timestamp          DateTime
  questionTranscript String
  questionType       String
  generatedResponse  String
  responseLatencyMs  Int
  wasPreComputed     Boolean          @default(false)
  telemetry          Json?
  sequenceOrder      Int

  createdAt          DateTime         @default(now())

  @@index([sessionId, sequenceOrder])
  @@map("exchanges")
}

model AnswerBank {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  resumeText     String
  jobDescription String
  interviewType  String

  answers        PreComputedAnswer[]

  deletedAt      DateTime?

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([userId])
  @@map("answer_banks")
}

model PreComputedAnswer {
  id           String     @id @default(cuid())
  bankId       String
  bank         AnswerBank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  question     String
  response     String
  questionType String

  createdAt    DateTime   @default(now())

  @@index([bankId])
  @@map("pre_computed_answers")
}

model WorkExperience {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  company   String
  startYear Int
  endYear   Int?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("work_experiences")
}

model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
  @@map("user_skills")
}

model InterviewProfile {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  isDefault          Boolean   @default(false)
  resumeText         String?   @db.Text
  currentRole        String?
  currentCompany     String?
  yearsInRole        Int?
  linkedinUrl        String?
  summary            String?   @db.Text
  communicationStyle String?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workExperiences  ProfileWorkExperience[]
  skills           ProfileSkill[]
  education        ProfileEducation[]
  certifications   ProfileCertification[]
  projects         ProfileProject[]
  achievements     ProfileAchievement[]

  @@index([userId])
  @@map("interview_profiles")
}

model ProfileWorkExperience {
  id          String           @id @default(cuid())
  profileId   String
  profile     InterviewProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  company     String
  startYear   Int
  endYear     Int?
  description String?          @db.Text
  createdAt   DateTime         @default(now())

  @@index([profileId])
  @@map("profile_work_experiences")
}

model ProfileSkill {
  id        String           @id @default(cuid())
  profileId String
  profile   InterviewProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  category  String?
  createdAt DateTime         @default(now())

  @@unique([profileId, name])
  @@index([profileId])
  @@map("profile_skills")
}

model ProfileEducation {
  id          String           @id @default(cuid())
  profileId   String
  profile     InterviewProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution String
  degree      String
  field       String?
  startYear   Int?
  endYear     Int?
  createdAt   DateTime         @default(now())

  @@index([profileId])
  @@map("profile_education")
}

model ProfileCertification {
  id        String           @id @default(cuid())
  profileId String
  profile   InterviewProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  issuer    String?
  year      Int?
  createdAt DateTime         @default(now())

  @@index([profileId])
  @@map("profile_certifications")
}

model ProfileProject {
  id          String           @id @default(cuid())
  profileId   String
  profile     InterviewProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  description String?          @db.Text
  techStack   String?
  url         String?
  year        Int?
  createdAt   DateTime         @default(now())

  @@index([profileId])
  @@map("profile_projects")
}

model ProfileAchievement {
  id          String           @id @default(cuid())
  profileId   String
  profile     InterviewProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  description String           @db.Text
  metric      String?
  year        Int?
  createdAt   DateTime         @default(now())

  @@index([profileId])
  @@map("profile_achievements")
}
