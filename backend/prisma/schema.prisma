generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  TRIAL
  PLUS
  PRO
  SANDBOX
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  IN_GRACE_PERIOD
  EXPIRED
  CANCELED
  REVOKED
  SANDBOX
}

enum BillingProvider {
  INTERNAL
  APP_STORE
}

enum SubscriptionProduct {
  NONE
  PLUS_MONTHLY
  PLUS_YEARLY
  PRO_MONTHLY
  PRO_YEARLY
  SANDBOX_FULL_ACCESS
}

enum AppStoreEnvironment {
  SANDBOX
  PRODUCTION
}

enum AccessSource {
  TRIAL
  SUBSCRIPTION
  SANDBOX
}

enum SessionMode {
  LIVE_INTERVIEW
  VOICE_PREP
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  displayName   String?
  avatarUrl     String?
  appAccountToken String? @unique @default(uuid())

  appleId       String?   @unique
  googleId      String?   @unique
  isSandboxTester Boolean @default(false)

  linkedinUrl          String?
  primaryGoal          String?
  resumeFileUrl        String?
  resumeText           String?   @db.Text
  currentRole          String?
  currentCompany       String?
  yearsInRole          Int?
  onboardingCompleted  Boolean  @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  emailVerified Boolean   @default(false)

  sessions      InterviewSession[]
  settings      UserSettings?
  apiKeys       UserApiKey[]
  answerBanks   AnswerBank[]
  refreshTokens RefreshToken[]
  entitlement   UserEntitlement?
  billingEvents BillingEvent[]
  sessionAccessGrants SessionAccessGrant[]
  workExperiences WorkExperience[]
  skills          UserSkill[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String?   @unique
  tokenHash String?   @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([token])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model UserEntitlement {
  id                           String              @id @default(cuid())
  userId                       String              @unique
  user                         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                         SubscriptionTier    @default(TRIAL)
  status                       SubscriptionStatus  @default(TRIALING)
  provider                     BillingProvider     @default(INTERNAL)
  product                      SubscriptionProduct @default(NONE)
  productId                    String?
  featuresOverride             Json?
  trialInterviewLimit          Int                 @default(5)
  trialInterviewsUsed          Int                 @default(0)
  currentPeriodStartedAt       DateTime            @default(now())
  currentPeriodEndsAt          DateTime?
  gracePeriodEndsAt            DateTime?
  lastPurchasedAt              DateTime?
  lastVerifiedAt               DateTime?
  appStoreEnvironment          AppStoreEnvironment?
  appStoreOriginalTransactionId String?            @unique
  appStoreLatestTransactionId  String?             @unique
  sandboxFullAccess            Boolean             @default(false)
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  billingEvents                BillingEvent[]

  @@index([status, tier])
  @@map("user_entitlements")
}

model BillingEvent {
  id                           String              @id @default(cuid())
  userId                       String
  user                         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  entitlementId                String?
  entitlement                  UserEntitlement?    @relation(fields: [entitlementId], references: [id], onDelete: SetNull)
  provider                     BillingProvider
  eventType                    String
  product                      SubscriptionProduct?
  productId                    String?
  appStoreTransactionId        String?
  appStoreOriginalTransactionId String?
  appStoreEnvironment          AppStoreEnvironment?
  effectiveAt                  DateTime?
  expiresAt                    DateTime?
  payload                      Json?
  payloadDigest                String?
  createdAt                    DateTime            @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([appStoreTransactionId])
  @@index([appStoreOriginalTransactionId])
  @@map("billing_events")
}

model SessionAccessGrant {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionClientId    String           @unique
  sessionMode        SessionMode      @default(LIVE_INTERVIEW)
  accessSource       AccessSource
  accessTier         SubscriptionTier
  featureSnapshot    Json?
  consumedTrial      Boolean          @default(false)
  trialInterviewNumber Int?
  createdAt          DateTime         @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("session_access_grants")
}

model UserSettings {
  id                     String  @id @default(cuid())
  userId                 String  @unique
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  defaultInterviewType   String  @default("general")
  defaultResponseFormat  String  @default("hybrid")
  defaultModel           String  @default("gpt-4.1-nano")
  shouldPreGenerate      Boolean @default(true)

  responseTemperature    Float   @default(0.7)
  maxResponseTokens      Int     @default(800)
  maxPreComputedQs       Int     @default(25)

  utteranceEndMs         Int     @default(1500)
  endpointingMs          Int     @default(500)
  predictiveFireMinWords Int     @default(8)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("user_settings")
}

model UserApiKey {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider     String   // "deepgram" | "openai"
  encryptedKey String
  keyIv        String
  keyTag       String
  keyPrefix    String   // First 4 chars for display

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@map("user_api_keys")
}

model InterviewSession {
  id              String     @id @default(cuid())
  clientId        String     @unique
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionMode     SessionMode @default(LIVE_INTERVIEW)
  accessSource    AccessSource @default(TRIAL)
  accessTier      SubscriptionTier @default(TRIAL)
  trialInterviewNumber Int?

  startedAt       DateTime
  endedAt         DateTime?
  resumeText      String
  jobDescription  String
  interviewType   String
  responseFormat  String
  modelUsed       String
  totalTokensUsed Int        @default(0)
  estimatedCost   Float      @default(0)
  telemetrySummary Json?

  technicalAccuracyScore  Float?
  communicationScore      Float?
  confidenceScore         Float?
  aiStrengths             Json?
  aiImprovements          Json?
  overallScore            Int?

  exchanges       Exchange[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId, startedAt(sort: Desc)])
  @@map("interview_sessions")
}

model Exchange {
  id                 String           @id @default(cuid())
  clientId           String           @unique
  sessionId          String
  session            InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  timestamp          DateTime
  questionTranscript String
  questionType       String
  generatedResponse  String
  responseLatencyMs  Int
  wasPreComputed     Boolean          @default(false)
  telemetry          Json?
  sequenceOrder      Int

  createdAt          DateTime         @default(now())

  @@index([sessionId, sequenceOrder])
  @@map("exchanges")
}

model AnswerBank {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  resumeText     String
  jobDescription String
  interviewType  String

  answers        PreComputedAnswer[]

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([userId])
  @@map("answer_banks")
}

model PreComputedAnswer {
  id           String     @id @default(cuid())
  bankId       String
  bank         AnswerBank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  question     String
  response     String
  questionType String

  createdAt    DateTime   @default(now())

  @@index([bankId])
  @@map("pre_computed_answers")
}

model WorkExperience {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  company   String
  startYear Int
  endYear   Int?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("work_experiences")
}

model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
  @@map("user_skills")
}
