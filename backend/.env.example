# ─── Core (required) ───────────────────────────────────────────
DATABASE_URL="postgresql://dev:dev@localhost:5432/interviewpilot?schema=public"
# Generate with: openssl rand -hex 32
JWT_SECRET=""
# Generate with: openssl rand -hex 32
API_KEY_ENCRYPTION_SECRET=""
PORT=3000
NODE_ENV=development

# ─── JWT claim binding (required in production) ────────────────
# Set distinct issuer per environment so dev tokens cannot be replayed against prod.
JWT_AUDIENCE="interviewpilot-ios"
JWT_ISSUER="interviewpilot-api-dev"

# ─── CORS ──────────────────────────────────────────────────────
# Use "*" for development. MUST be a concrete origin in production
# (the server hard-fails on wildcard + NODE_ENV=production).
CORS_ORIGIN="*"

# ─── Redis (optional — falls back to in-memory) ───────────────
# REDIS_URL="redis://localhost:6379"

# ─── Database tuning ──────────────────────────────────────────
# DATABASE_POOL_SIZE=15

# ─── AI Service API Keys (server-side only — never returned to client) ─
DEEPGRAM_API_KEY=""
OPENAI_API_KEY=""
# Chat-completion provider for live answers, answer-bank pre-gen, and post-session
# analysis. "deepseek" / "groq" route to their OpenAI-compatible APIs; transcription
# stays on Deepgram and the realtime voice path stays on OpenAI regardless.
# Dev/full-access accounts can override this per-device from the iOS provider menu.
AI_CHAT_PROVIDER="openai"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# Groq is the fastest + cheapest option; GROQ_MODEL is overridable so a model
# deprecation is a var change, not a redeploy. See https://console.groq.com/docs/models
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"

# ─── Apple Sign-In ────────────────────────────────────────────
# Get these from App Store Connect → Users and Access → Keys.
# The PRIVATE_KEY is a PEM block — keep it OUT of version control.
# Provide via Railway secret manager / .env.local (gitignored) only.
APPLE_SIGN_IN_TEAM_ID=""
APPLE_SIGN_IN_KEY_ID=""
APPLE_SIGN_IN_PRIVATE_KEY=""
APPLE_SIGN_IN_AUDIENCES="com.res.jobhopperAI"

# ─── App Store Billing ────────────────────────────────────────
APP_STORE_BUNDLE_ID="com.res.jobhopperAI"
APP_STORE_APPLE_ID=""
APP_STORE_ENABLE_ONLINE_CHECKS=false
APP_STORE_PLUS_MONTHLY_PRODUCT_ID="com.res.jobhopperAI.plus.monthly"
APP_STORE_PLUS_YEARLY_PRODUCT_ID="com.res.jobhopperAI.plus.yearly"
APP_STORE_PRO_MONTHLY_PRODUCT_ID="com.res.jobhopperAI.pro.monthly"
APP_STORE_PRO_YEARLY_PRODUCT_ID="com.res.jobhopperAI.pro.yearly"
TRIAL_INTERVIEW_LIMIT=5
SANDBOX_TESTER_EMAILS=""

# ─── Trial & Free Tier ───────────────────────────────────────
TRIAL_DURATION_DAYS=7                    # Length of free trial in days (1-90)
FREE_MONTHLY_INTERVIEW_LIMIT=3           # Monthly interview limit for free users (0-100)

# ─── Email / Password Reset (optional — logs warning if unset) ─
# SENDGRID_API_KEY=""
# SENDGRID_FROM_EMAIL="noreply@interviewpilot.app"
# APP_URL="https://interviewpilot.app"

# ─── Cloudflare R2 File Storage (optional) ────────────────────
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_URL=""

# ─── Error Tracking (optional) ────────────────────────────────
# SENTRY_DSN=""
