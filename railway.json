{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/backend/**",
      "/backend/railway.json",
      "/Dockerfile",
      "/railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": "sh -lc 'if [ -f backend/package.json ]; then cd backend; fi; npx prisma db push --skip-generate --accept-data-loss'",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
